{
  "name": "defenx",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "python_workers",
    "enable_ctx_exports"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/demo",
      "/secure-login",
      "/api/*"
    ],
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME_HUB",
        "class_name": "RealtimeHub"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RealtimeHub"
      ]
    }
  ],
  "keep_vars": true,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "5fc226adbd6347dfb1694c19a64256ee"
    }
  ]
}
