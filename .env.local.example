# Copy to .env and set strong, unique values before running DEFENX locally.
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=ADMIN
ADMIN_PASSWORD=replace-with-a-strong-admin-password
COOKIE_SECURE=0
HOST=127.0.0.1
PORT=5000
# Optional persistent PostgreSQL storage. Without this, database-backed
# friend accounts, enrollment persistence and long-term audit history are off.
DATABASE_URL=
ROVER_DEVICE_TOKEN=
# Optional hosted detection; frames are sent to this configured provider while enabled.
# Set YOLO_API_URL to https://serverless.roboflow.com/<project>/<version>.
YOLO_API_KEY=
YOLO_API_URL=

ROVER_CAMERA_STREAM_URL=
ROVER_CAMERA_STREAM_TYPE=mjpeg

