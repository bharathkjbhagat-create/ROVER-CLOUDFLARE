SESSION_SECRET=
ADMIN_USERNAME=ADMIN
ADMIN_PASSWORD=
FRIEND_MAHANTESH_PASSWORD=
FRIEND_DHANUSH_PASSWORD=
FRIEND_ANIRUDH_PASSWORD=
FRIEND4_PASSWORD=
ROVER_DEVICE_TOKEN=
# Hosted YOLO detection; keep values blank in this template.
YOLO_API_KEY=
YOLO_API_URL=https://serverless.roboflow.com/<project>/<version>

ROVER_CAMERA_STREAM_URL=
ROVER_CAMERA_STREAM_TYPE=mjpeg
LIVE_SYNC_SECRET=
COOKIE_SECURE=true
# Random 32+ character key for AES-256-GCM face enrollment encryption.
FACE_DATA_KEY=

# ---- Device fleet / rover sync (added) -------------------------------------
# Master secret used to derive every per-device secret (>= 32 random chars). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Set as a Cloudflare secret:  npx wrangler secret put FLEET_MASTER_SECRET   (never commit a real value)
FLEET_MASTER_SECRET=
# Device id whose telemetry drives the existing dashboard (map, battery, obstacle, camera)
FLEET_PRIMARY_ROVER=ROVER-01
# Seconds without an authenticated heartbeat before a device is shown OFFLINE (minimum 5)
DEVICE_OFFLINE_AFTER_SECONDS=8

# Optional TURN relay for restrictive mobile/carrier NATs (coturn REST API).
# Store RTC_TURN_SHARED_SECRET as a Cloudflare secret, never commit its value.
# RTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# RTC_TURN_SHARED_SECRET=<Cloudflare secret>

# Optional Cloudflare Realtime TURN relay (short-lived credentials generated server-side).
# Create a TURN key in Cloudflare Realtime, then store both values as Worker secrets.
# RTC_TURN_KEY_ID=<TURN key ID>
# RTC_TURN_API_TOKEN=<TURN key API token>
# TURN usage has a free allowance and may be billable beyond it; keep unset unless approved.
