# ---- Device fleet / rover sync (added) -------------------------------------
# Master secret used to derive every per-device secret (>= 32 random chars). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Set as a Cloudflare secret:  npx wrangler secret put FLEET_MASTER_SECRET   (never commit a real value)
FLEET_MASTER_SECRET=
# Device id whose telemetry drives the existing dashboard (map, battery, obstacle, camera)
FLEET_PRIMARY_ROVER=ROVER-01
# Seconds without an authenticated heartbeat before a device is shown OFFLINE (minimum 5)
DEVICE_OFFLINE_AFTER_SECONDS=8
